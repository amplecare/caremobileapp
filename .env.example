# Supabase — same project as the web Agency Hub.
# EXPO_PUBLIC_ vars are embedded in the app bundle, so ONLY ever put the anon
# key here. The service-role key must never reach a device: it bypasses RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
